# Upstox API Credentials
# Copy this file to .env.options and fill in your actual credentials
# NEVER commit .env.options to version control

UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here
UPSTOX_ACCESS_TOKEN=your_access_token_here

# Optional: Upstox redirect URI for OAuth flow
UPSTOX_REDIRECT_URI=http://localhost:8080/callback

# Groww API (used by scripts/build_groww_option_universe.py)
# Option A: direct bearer token (access token)
GROWW_API_AUTH_TOKEN=your_groww_auth_token_here
# Option B: API key + secret/totp (script auto-generates access token via /token/api/access)
GROWW_API_KEY=your_groww_api_key_here
GROWW_API_SECRET=your_groww_api_secret_here
GROWW_API_TOTP=your_6_digit_totp_here
