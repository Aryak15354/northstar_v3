{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "standard": {
      "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
    }
  },
  "handlers": {
    "file": {
      "level": "INFO",
      "class": "logging.handlers.RotatingFileHandler",
      "filename": "/Users/aryakghoshal/Downloads/northstar/northstar_v3/logs/daily_execution.log",
      "maxBytes": 10485760,
      "backupCount": 5,
      "formatter": "standard"
    },
    "console": {
      "level": "INFO",
      "class": "logging.StreamHandler",
      "formatter": "standard"
    }
  },
  "loggers": {
    "": {
      "handlers": [
        "file",
        "console"
      ],
      "level": "INFO",
      "propagate": false
    }
  }
}